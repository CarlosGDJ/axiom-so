/**
 * This ruleset enforces a strict user-ownership security model for the LifeOS application.
 *
 * Core Philosophy:
 * The fundamental principle is data privacy and isolation. Users have exclusive access to their own information.
 * No user can read, write, or even know about the existence of another user's data.
 *
 * Data Structure:
 * All application data is hierarchically organized under the `/users/{userId}` path.
 * This structure naturally partitions data, making security rules simple, performant, and easy to reason about.
 * Each user's data, from events to financial transactions, is stored in dedicated subcollections under their unique user ID.
 *
 * Key Security Decisions:
 * - Default Deny: All operations are denied unless explicitly allowed by a rule.
 * - User Listing Disabled: It is impossible for any client to list all documents in the top-level `/users` collection.
 * - No Public Data: All collections and subcollections are private to the owning user.
 * - Root Document Protection: A user's root document (`/users/{userId}`) cannot be deleted from the client to prevent accidental data loss.
 *
 * Denormalization for Authorization:
 * This ruleset relies on the path structure for authorization. The user's UID in the document path (`/users/{userId}/...`)
 * is the sole source of truth for ownership checks. This avoids slow and costly `get()` calls to other documents, ensuring
 * high performance and low read costs.
 *
 * Structural Segregation:
 * The entire data model uses structural segregation. All data is inherently private by being nested under a user-specific path.
 * This is the most secure and performant way to manage user-private data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Validates that the currently authenticated user is the owner of the document
     * based on the `userId` in the path.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * For update and delete operations, validates ownership AND ensures the document exists.
     * This prevents operations on non-existent data, which is a security best practice.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the root user document.
     * @path /users/{userId}
     * @allow (create) A new user `auth.uid: 'user_abc'` can create their own document at `/users/user_abc`.
     * @deny (list) A user cannot list all documents in the `/users` collection.
     * @deny (delete) A user `auth.uid: 'user_abc'` cannot delete their own root document `/users/user_abc`.
     * @principle Enables user self-registration while protecting the user's root document and preventing user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      /**
       * @description Generic rules for ALL user-specific subcollections (events, skills, habits, etc.).
       * @path /users/{userId}/{anyCollection}/{docId}
       * @allow (create) User `auth.uid: 'user_abc'` can create a new event at `/users/user_abc/events/event_123`.
       * @allow (list) User `auth.uid: 'user_abc'` can list all of their own habits in `/users/user_abc/habits`.
       * @deny (get) User `auth.uid: 'user_xyz'` CANNOT read an event at `/users/user_abc/events/event_123`.
       * @deny (update) User `auth.uid: 'user_abc'` CANNOT update a document belonging to another user.
       * @principle Enforces strict data ownership for all user-generated content, ensuring complete data privacy.
       */
      match /{anyCollection}/{docId=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
